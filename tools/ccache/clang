#!/bin/sh
# C compiler wrapper for the MAME cores.
#
# Routes compilation through ccache when it is installed and straight to the
# real compiler when it is not, so a checkout on a machine without ccache
# still builds. Wired as CC in project.yml's mame-base group; the flags Xcode
# passes are forwarded unchanged, and ccache passes link commands through to
# the compiler untouched. See docs/apple-shell.md for the cache's location
# and how to inspect it (`ccache -s`).
set -e
if command -v ccache >/dev/null 2>&1; then
    exec ccache /usr/bin/clang "$@"
fi
exec /usr/bin/clang "$@"
